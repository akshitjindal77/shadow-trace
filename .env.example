# API Keys
HIBP_API_KEY=your_haveibeenpwned_api_key_here
ABUSEIPDB_API_KEY=your_abuseipdb_api_key_here

# Database
DATABASE_URL=sqlite:///./shadowtrace.db

# API Configuration
API_HOST=127.0.0.1
API_PORT=8000
DEBUG=True

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_PERIOD=3600

# CORS
CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:8000"]

# External Services
DUCKDUCKGO_TIMEOUT=30
WHOIS_TIMEOUT=10
DNS_TIMEOUT=5
